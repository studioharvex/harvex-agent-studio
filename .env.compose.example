# Harvex with docker compose. Copy to .env (git-ignored), fill the empty values, then:
#   Coolify:     docker-compose.yml only (set these in the Environment Variables tab instead of a file)
#   plain VPS:   docker compose -f docker-compose.yml -f docker-compose.standalone.yml up -d --build
# Secrets stay in .env on the server only. Generate BETTER_AUTH_SECRET and CLAIMS_ADMIN_TOKEN with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ---- domain (docker-compose.standalone.yml: Caddy gets the certificate for HARVEX_DOMAIN)
HARVEX_DOMAIN=harvex.example
HTTP_PORT=80
HTTPS_PORT=443

APP_ORIGIN=https://harvex.example
BETTER_AUTH_SECRET=
AI_ENABLED=true
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
AI_MODEL_FREE=gemini-3.1-flash-lite,gemini-3.5-flash-lite
AI_REASONING_EFFORT=low
AI_WEB_SEARCH=google
AI_MAX_TOKENS=8000
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
STARTING_CREDITS=25
LIVE_SKILL_COSTS=research=12,document=6,code=6,write=5,summarize=4,translate=4,brainstorm=4,planner=4
# free credits refill every 24 h (free part topped back up to 25); heavy skills limited per 5-hour window
FREE_REFILL_CREDITS=25
FREE_REFILL_HOURS=24
LIMIT_WINDOW_HOURS=5
HEAVY_SKILLS=research,document,code
FREE_HEAVY_PER_WINDOW=2
PAID_HEAVY_PER_WINDOW=20
LIVE_RUN_COST=5
LIVE_DAILY_PER_USER=20
AI_DAILY_RUNS=3000
# part of AI_DAILY_RUNS that accounts without bought credits may use together (empty = 70%)
AI_DAILY_FREE_RUNS=
# web search costs per query: research runs a day that may use it (0 = never), and whether free credits may use it
AI_DAILY_SEARCH_RUNS=150
AI_SEARCH_FREE_CREDITS=true
PLATFORM_FEE_BPS=0
SKILL_TRIAL_LIMIT=2
SCHEDULES_ENABLED=true
SCHEDULE_RUN_COST=5
SCHEDULE_MAX=3
SCHEDULE_DAILY_RUNS=24
HARVEX_BACKUP_DAYS=7
# BNB Smart Chain: mainnet = chain 56, testnet = chain 97. Every chain feature stays OFF while its addresses are empty.
CHAIN_NETWORK=mainnet
# RPC from a provider, with archive access. The public RPC refuses eth_getLogs and keeps no old state, so tiers, Whale
# watch and rewards do not work on it. CHAIN_LOGS_RPC_URL is only needed when logs should come from another endpoint.
CHAIN_RPC_URL=
CHAIN_LOGS_RPC_URL=
# top-ups: USDT on BNB Smart Chain mainnet is 0x55d398326f99059fF775485246999027B3197955 (18 decimals; check it on
# bscscan.com). Setting PAY_TOKEN_ADDRESS turns top-ups on and then TOPUP_TREASURY (your multisig) is required.
PAY_TOKEN_ADDRESS=
PAY_TOKEN_SYMBOL=USDT
PAY_TOKEN_DECIMALS=18
TOPUP_TREASURY=
CREDITS_PER_TOKEN=100
TOPUP_FINALITY=safe
TOPUP_MIN_CONFIRMATIONS=3
CLAIMS_ENABLED=false
CLAIMS_CONTRACT=
CLAIM_MIN_CREDITS=500
CLAIMS_ADMIN_TOKEN=
HARVEX_TOKEN_ADDRESS=
TIER_BASE_CREDITS=100
# holder rewards: OFF. The reward token is not chosen; when it is, set its address, symbol and decimals, a second
# HarvexClaims as REWARD_CONTRACT and (optional) its Chainlink USD feed on BNB Smart Chain.
REWARDS_ENABLED=false
REWARD_TOKEN_ADDRESS=
REWARD_TOKEN_SYMBOL=
REWARD_TOKEN_DECIMALS=
REWARD_CONTRACT=
REWARD_HARVEX_PER_UNIT=3000000
REWARD_USD_PER_UNIT_HOUR=0.01
REWARD_PRICE_FEED=
REWARD_PRICE_MAX_AGE_HOURS=72
REWARD_PERIOD_HOURS=1
REWARD_AUTO=true
# hourly claims: dedicated key that can ONLY post reward roots (generate a new one on a clean device, fund it with a little BNB; the Safe calls setPayoutLimit FIRST, then setRootPoster). Empty = Safe posts roots.
REWARD_ROOT_POSTER_KEY=
REWARD_START_BLOCK=0
REWARD_EXCLUDE=
HARVEX_NOINDEX=
# true ONLY when the domain is proxied by Cloudflare and the server cannot be reached directly (cf-* headers are otherwise forgeable)
HARVEX_TRUST_CF_HEADERS=
# Parts that are not open yet (lib/gate.ts): chain, app, community, signin, separated by commas, or "all".
# Their pages show a "not open yet" page and their API routes answer 403. Empty = everything is open.
# CLOSED_SECTIONS=chain,app,community,signin
