# Server-side configuration. Set these as Worker vars/secrets in Cloudflare (never in frontend files).
# Secrets (wrangler secret put ...):
OPENAI_API_KEY=
AI_GATEWAY_KEY=
# Vars (written by scripts/deploy.mjs from deploy.config.json):
AI_ENABLED=false
OPENAI_MODEL=gpt-6-luna
AI_GATEWAY_URL=
PLATFORM_FEE_BPS=0
APP_ORIGIN=https://harvex.studio
AUTH_TRUST_SITES_HEADERS=false
