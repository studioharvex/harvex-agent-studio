.qwen/
.qodo/
.specstory/
.aider*
.copilot/
copilot-instructions.md
.github/copilot-instructions.md
.github/instructions/
.github/prompts/
.gemini/
GEMINI.md
QWEN.md
WARP.md
.mcp.json
mcp.json
.aiignore
.aiexclude
.rules
/prompts/
*.prompt.md
PROMPT*.txt
PROMPT*.md
/HANDOFF/
CHANGES-CLAUDE-*
transcripts/
graphify-out/
.graphify/

# ---------------------------------------------------------------- OS
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- scraped & third-party content
# anything fetched from other websites (pages, screenshots, branding dumps) and the notes written from it
.firecrawl/
*firecrawl*
*scrape*
*scraping*
scraped/
crawl/
crawls/
crawled/
*-crawl.*
/DESIGN.md
DESIGN-*.md
